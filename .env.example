# Application Configuration
APP_NAME="Bulk Certificate Generation & Alert API"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (SQLite / PostgreSQL)
DATABASE_URL="sqlite:///./bulk_certs.db"
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/bulk_certs_db

# File Storage Configuration
STORAGE_DIR="./generated_certificates"
MAX_BATCH_SIZE=5000

# Security / API Key (Optional API Key Protection)
API_KEY_ENABLED=False
API_KEY="secret-api-key-here"

# Concurrency / Background Processing
MAX_WORKER_CONCURRENCY=5
